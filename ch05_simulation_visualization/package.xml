<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ch05_simulation_visualization</name>
  <version>1.0.0</version>
  <description>
    ROS 2 ile Endüstriyel Robot Programlama - Bölüm 5: RViz2, Gazebo Harmonic,
    ros_gz köprüsü ve ros2_control donanım kipleri (mock / Gazebo) örnekleri.
  </description>
  <maintainer email="cshyilmaz@gmail.com">Cem Süha Yılmaz</maintainer>
  <license>Apache-2.0</license>

  <!-- Örnek yörünge düğümü -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>

  <!-- Robot modeli ve görselleştirme -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- ros2_control: denetleyici yöneticisi, denetleyiciler ve sahte donanım
       (mock_components/GenericSystem, hardware_interface paketindedir) -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <!-- Gazebo Harmonic entegrasyonu (README'deki Humble + Harmonic notuna bakınız) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- 5.7: kayıt, yeniden oynatma ve rqt araçları -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>rqt_graph</exec_depend>
  <exec_depend>rqt_topic</exec_depend>
  <exec_depend>rqt_console</exec_depend>
  <exec_depend>rqt_reconfigure</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
