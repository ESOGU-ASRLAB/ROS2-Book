<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ch07_viewpoint_planner</name>
  <version>1.0.0</version>
  <description>
    ROS 2 ile Endüstriyel Robot Programlama - Bölüm 7: bakış noktası planlamasının
    geometri (yüzey örnekleme, aday üretimi, kaplama) ve erişilebilirlik (IK)
    modülleri.
  </description>
  <maintainer email="cshyilmaz@gmail.com">Cem Süha Yılmaz</maintainer>
  <license>Apache-2.0</license>

  <!-- Erişilebilirlik denetimi: MoveIt 2 /compute_ik servisi -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- Geometri: ağ okuma, örnekleme, ışın kesişimi ve dönüşümler -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-trimesh-pip</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
